<Window x:Class="_08_FileManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_08_FileManager"
        mc:Ignorable="d"
        Title="File Analyzer" Height="600" Width="900">
    <Window.Resources>
        <Style TargetType="{x:Type Button}" >
            <Setter Property="Margin" Value="5"></Setter>
            <Setter Property="Padding" Value="5"></Setter>            
            <Setter Property="FontWeight" Value="Bold"></Setter>            
            <Setter Property="FontSize" Value="20"></Setter>            
        </Style>
        <Style TargetType="{x:Type Label}" >
            <Setter Property="FontWeight" Value="Bold"></Setter>
            <Setter Property="FontSize" Value="20"></Setter>
        </Style>
        <Style TargetType="{x:Type TextBox}" >
            <Setter Property="Margin" Value="7"></Setter>
            <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        </Style>

    </Window.Resources>
    <DockPanel>
       
    <Grid Margin="7" DockPanel.Dock="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label>Folder:</Label>
        <TextBox Grid.Column="1" Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" Name="fromTextBox"></TextBox>
        <Button Grid.Column="2" Click="Source_Button_Click">Browse</Button>
        <Button Grid.Row="1" Grid.ColumnSpan="3" Click="Analyze_Button_Click"
                IsEnabled="{Binding CanAnalyze}">Analyze files</Button>
        </Grid>
        <ProgressBar Value="{Binding Progress}" Height="15" Name="progressBar"
                     DockPanel.Dock="Bottom" IsIndeterminate="{Binding IsWaiting}"></ProgressBar>
        <TabControl>
            <TabItem Header="Summary">
                <ListBox ItemsSource="{Binding Summary}" Margin="7"/>
            </TabItem>
            <TabItem Header="Extensions">
                <ListBox ItemsSource="{Binding Extensions}" Margin="7"/>
            </TabItem>
            <TabItem Header="Duplicates">
                <ListBox ItemsSource="{Binding Duplicates}" Margin="7"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>